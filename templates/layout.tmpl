{{ define "layout" }}
<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>TheStreetPost | {{ .Title }}</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/htmx.org@1.9.12"></script>
</head>
<body class="min-h-screen bg-slate-950 text-slate-100" hx-boost="true" hx-target="#content" hx-select="#content" hx-swap="innerHTML">
    <nav class="border-b border-slate-800 bg-slate-950/80 backdrop-blur">
        <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-4">
            <a href="/" class="text-lg font-semibold tracking-wide text-white">TheStreetPost</a>
            <div class="hidden items-center gap-6 text-sm font-medium text-slate-200 md:flex">
                <a href="/" class="transition hover:text-white">Home</a>
                <a href="/news" class="transition hover:text-white">News</a>
                <a href="/blog" class="transition hover:text-white">Blog</a>
                <a href="/about" class="transition hover:text-white">About</a>
                <a href="/contact" class="transition hover:text-white">Contact</a>
            </div>
            <a href="/signin" class="rounded-full border border-white/20 px-4 py-2 text-sm font-semibold text-white transition hover:border-white">Sign In</a>
        </div>
    </nav>

    <main id="content" class="mx-auto w-full max-w-6xl px-4 py-10">
        {{ template .ContentTemplate . }}
    </main>

    <footer class="border-t border-slate-800 bg-slate-950/80">
        <div class="mx-auto grid max-w-6xl gap-8 px-4 py-10 md:grid-cols-3">
            <div>
                <h3 class="text-lg font-semibold">About TheStreetPost</h3>
                <p class="mt-3 text-sm text-slate-300">Your source for street culture, news, and insights.</p>
            </div>
            <div>
                <h3 class="text-lg font-semibold">Quick Links</h3>
                <ul class="mt-3 space-y-2 text-sm text-slate-300">
                    <li><a class="transition hover:text-white" href="/">Home</a></li>
                    <li><a class="transition hover:text-white" href="/news">News</a></li>
                    <li><a class="transition hover:text-white" href="/about">About</a></li>
                    <li><a class="transition hover:text-white" href="/contact">Contact</a></li>
                </ul>
            </div>
            <div>
                <h3 class="text-lg font-semibold">Follow Us</h3>
                <ul class="mt-3 space-y-2 text-sm text-slate-300">
                    <li><a class="transition hover:text-white" href="#">Twitter</a></li>
                    <li><a class="transition hover:text-white" href="#">Instagram</a></li>
                    <li><a class="transition hover:text-white" href="#">Facebook</a></li>
                </ul>
            </div>
        </div>
        <div class="border-t border-slate-800 px-4 py-6 text-center text-xs text-slate-400">
            &copy; {{ .Year }} TheStreetPost. All rights reserved.
        </div>
    </footer>
</body>
</html>
{{ end }}
