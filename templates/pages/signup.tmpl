{{ define "signup" }}
<section class="mx-auto max-w-lg rounded-3xl border border-slate-800 bg-slate-900/60 p-8">
    <h1 class="text-2xl font-semibold">Create Account</h1>
    <p class="mt-2 text-sm text-slate-300">Join the community in seconds.</p>
    <form class="mt-6 grid gap-4">
        <div>
            <label class="text-xs uppercase tracking-widest text-slate-400">Full Name</label>
            <input type="text" name="name" required class="mt-2 w-full rounded-2xl border border-slate-700 bg-slate-950 px-4 py-3 text-sm text-white" />
        </div>
        <div>
            <label class="text-xs uppercase tracking-widest text-slate-400">Email</label>
            <input type="email" name="email" required class="mt-2 w-full rounded-2xl border border-slate-700 bg-slate-950 px-4 py-3 text-sm text-white" />
        </div>
        <div>
            <label class="text-xs uppercase tracking-widest text-slate-400">Username</label>
            <input type="text" name="username" required class="mt-2 w-full rounded-2xl border border-slate-700 bg-slate-950 px-4 py-3 text-sm text-white" />
        </div>
        <div>
            <label class="text-xs uppercase tracking-widest text-slate-400">Password</label>
            <input type="password" name="password" required class="mt-2 w-full rounded-2xl border border-slate-700 bg-slate-950 px-4 py-3 text-sm text-white" />
        </div>
        <div>
            <label class="text-xs uppercase tracking-widest text-slate-400">Confirm Password</label>
            <input type="password" name="passwordConfirm" required class="mt-2 w-full rounded-2xl border border-slate-700 bg-slate-950 px-4 py-3 text-sm text-white" />
        </div>
        <label class="flex items-center gap-2 text-xs text-slate-400">
            <input type="checkbox" name="terms" required class="h-4 w-4 rounded border-slate-700 bg-slate-950" />
            I agree to the <a href="#" class="text-emerald-300">Terms of Service</a>
        </label>
        <button type="submit" class="rounded-full bg-emerald-400 px-6 py-3 text-sm font-semibold text-black transition hover:bg-emerald-300">Create Account</button>
        <p class="text-center text-xs text-slate-400">Already have an account? <a href="/signin" class="text-emerald-300">Sign in here</a></p>
    </form>
</section>
{{ end }}
