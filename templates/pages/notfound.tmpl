{{ define "notfound" }}
<section class="mx-auto max-w-xl rounded-3xl border border-slate-800 bg-slate-900/60 p-10 text-center">
    <p class="text-sm uppercase tracking-[0.2em] text-emerald-300">404</p>
    <h1 class="mt-4 text-3xl font-semibold">Page Not Found</h1>
    <p class="mt-3 text-sm text-slate-300">The page you're looking for doesn't exist.</p>
    <a href="/" class="mt-6 inline-flex rounded-full bg-emerald-400 px-6 py-3 text-sm font-semibold text-black transition hover:bg-emerald-300">Go Back Home</a>
</section>
{{ end }}
