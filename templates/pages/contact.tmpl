{{ define "contact" }}
<header class="flex flex-col gap-3">
    <p class="text-sm uppercase tracking-[0.2em] text-emerald-300">Contact</p>
    <h1 class="text-3xl font-semibold md:text-4xl">Get in touch</h1>
    <p class="text-slate-300">We'd love to hear from you. Reach out to TheStreetPost.</p>
</header>

<section class="mt-8 grid gap-6 lg:grid-cols-[1.1fr_1fr]">
    <div class="rounded-3xl border border-slate-800 bg-slate-900/60 p-8">
        <h2 class="text-xl font-semibold">Contact details</h2>
        <div class="mt-6 space-y-4 text-sm text-slate-300">
            <div>
                <p class="text-xs uppercase tracking-widest text-emerald-300">Email</p>
                <a class="mt-2 inline-flex text-white" href="mailto:hello@thestreetpost.com">hello@thestreetpost.com</a>
            </div>
            <div>
                <p class="text-xs uppercase tracking-widest text-emerald-300">Phone</p>
                <a class="mt-2 inline-flex text-white" href="tel:+1-555-0123">+1 (555) 0123</a>
            </div>
            <div>
                <p class="text-xs uppercase tracking-widest text-emerald-300">Address</p>
                <p class="mt-2">123 Urban Street<br />Downtown District<br />City, State 12345</p>
            </div>
            <div>
                <p class="text-xs uppercase tracking-widest text-emerald-300">Follow</p>
                <div class="mt-2 flex flex-wrap gap-4">
                    <a href="#" class="text-white">Twitter</a>
                    <a href="#" class="text-white">Instagram</a>
                    <a href="#" class="text-white">Facebook</a>
                    <a href="#" class="text-white">TikTok</a>
                </div>
            </div>
        </div>
    </div>
    <form class="rounded-3xl border border-slate-800 bg-slate-900/60 p-8">
        <h2 class="text-xl font-semibold">Send a message</h2>
        <div class="mt-6 grid gap-4">
            <div>
                <label class="text-xs uppercase tracking-widest text-slate-400">Name</label>
                <input type="text" name="name" required class="mt-2 w-full rounded-2xl border border-slate-700 bg-slate-950 px-4 py-3 text-sm text-white" />
            </div>
            <div>
                <label class="text-xs uppercase tracking-widest text-slate-400">Email</label>
                <input type="email" name="email" required class="mt-2 w-full rounded-2xl border border-slate-700 bg-slate-950 px-4 py-3 text-sm text-white" />
            </div>
            <div>
                <label class="text-xs uppercase tracking-widest text-slate-400">Phone (Optional)</label>
                <input type="tel" name="phone" class="mt-2 w-full rounded-2xl border border-slate-700 bg-slate-950 px-4 py-3 text-sm text-white" />
            </div>
            <div>
                <label class="text-xs uppercase tracking-widest text-slate-400">Subject</label>
                <select name="subject" required class="mt-2 w-full rounded-2xl border border-slate-700 bg-slate-950 px-4 py-3 text-sm text-white">
                    <option value="">Select a subject</option>
                    <option value="story">Submit a story</option>
                    <option value="feedback">Feedback</option>
                    <option value="partnership">Partnership inquiry</option>
                    <option value="advertising">Advertising</option>
                    <option value="other">Other</option>
                </select>
            </div>
            <div>
                <label class="text-xs uppercase tracking-widest text-slate-400">Message</label>
                <textarea name="message" rows="5" required class="mt-2 w-full rounded-2xl border border-slate-700 bg-slate-950 px-4 py-3 text-sm text-white"></textarea>
            </div>
            <button type="submit" class="rounded-full bg-emerald-400 px-6 py-3 text-sm font-semibold text-black transition hover:bg-emerald-300">Send message</button>
        </div>
    </form>
</section>
{{ end }}
