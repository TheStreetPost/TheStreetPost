{{ define "about" }}
<header class="flex flex-col gap-3">
    <p class="text-sm uppercase tracking-[0.2em] text-emerald-300">Our Story</p>
    <h1 class="text-3xl font-semibold md:text-4xl">About TheStreetPost</h1>
    <p class="text-slate-300">Learn more about our mission and community.</p>
</header>

<section class="mt-8 grid gap-6 lg:grid-cols-2">
    <div class="rounded-3xl border border-slate-800 bg-slate-900/60 p-8">
        <h2 class="text-xl font-semibold">Our Mission</h2>
        <p class="mt-3 text-sm text-slate-300">TheStreetPost is dedicated to bringing authentic street culture, urban news, and community stories to the forefront. We believe in celebrating the diverse voices and perspectives that make up our streets.</p>
    </div>
    <div class="rounded-3xl border border-slate-800 bg-slate-900/60 p-8">
        <h2 class="text-xl font-semibold">What We Cover</h2>
        <ul class="mt-3 space-y-2 text-sm text-slate-300">
            <li>Street fashion & style</li>
            <li>Urban art & murals</li>
            <li>Music & entertainment</li>
            <li>Local community news</li>
            <li>Cultural events</li>
            <li>Social commentary</li>
        </ul>
    </div>
    <div class="rounded-3xl border border-slate-800 bg-slate-900/60 p-8">
        <h2 class="text-xl font-semibold">Our Team</h2>
        <p class="mt-3 text-sm text-slate-300">We are a passionate group of journalists, photographers, and community members dedicated to authentic storytelling and bringing real urban narratives to light.</p>
    </div>
    <div class="rounded-3xl border border-slate-800 bg-slate-900/60 p-8">
        <h2 class="text-xl font-semibold">Get Involved</h2>
        <p class="mt-3 text-sm text-slate-300">Have a story to share? We'd love to hear from you. Reach out at <span class="font-semibold text-white">hello@thestreetpost.com</span> or visit our contact page.</p>
        <a href="/contact" class="mt-4 inline-flex text-sm font-semibold text-emerald-300 hover:text-emerald-200">Contact Us →</a>
    </div>
</section>
{{ end }}
