{{ define "welcome" }}
<section class="rounded-3xl border border-slate-800 bg-gradient-to-br from-slate-900 via-slate-950 to-black p-10 shadow-xl">
    <div class="max-w-2xl">
        <p class="text-sm uppercase tracking-[0.2em] text-emerald-300">Street Culture & Urban News</p>
        <h1 class="mt-4 text-4xl font-semibold leading-tight text-white md:text-5xl">Welcome to TheStreetPost</h1>
        <p class="mt-4 text-lg text-slate-300">Your ultimate source for street culture, local stories, and the people shaping the city.</p>
        <div class="mt-6 flex flex-wrap gap-4">
            <a href="/news" class="rounded-full bg-emerald-400 px-6 py-3 text-sm font-semibold text-black transition hover:bg-emerald-300">Explore News</a>
            <a href="/signin" class="rounded-full border border-slate-600 px-6 py-3 text-sm font-semibold text-white transition hover:border-white">Join Us</a>
        </div>
    </div>
</section>

<section class="mt-12">
    <div class="flex items-center justify-between">
        <h2 class="text-2xl font-semibold">Featured Stories</h2>
        <a href="/news" class="text-sm font-semibold text-emerald-300 hover:text-emerald-200">View all</a>
    </div>
    <div class="mt-6 grid gap-6 md:grid-cols-3">
        <article class="rounded-2xl border border-slate-800 bg-slate-900/60 p-6">
            <p class="text-xs uppercase tracking-widest text-emerald-300">Urban Culture</p>
            <h3 class="mt-3 text-lg font-semibold">Street fashion, art, and music</h3>
            <p class="mt-2 text-sm text-slate-300">Discover the latest trends in street culture and creative expression.</p>
            <a href="/news" class="mt-4 inline-flex text-sm font-semibold text-emerald-300 hover:text-emerald-200">Read More →</a>
        </article>
        <article class="rounded-2xl border border-slate-800 bg-slate-900/60 p-6">
            <p class="text-xs uppercase tracking-widest text-emerald-300">Local News</p>
            <h3 class="mt-3 text-lg font-semibold">Neighborhood stories</h3>
            <p class="mt-2 text-sm text-slate-300">Stay updated with what's happening in your city and community.</p>
            <a href="/news" class="mt-4 inline-flex text-sm font-semibold text-emerald-300 hover:text-emerald-200">Read More →</a>
        </article>
        <article class="rounded-2xl border border-slate-800 bg-slate-900/60 p-6">
            <p class="text-xs uppercase tracking-widest text-emerald-300">Community</p>
            <h3 class="mt-3 text-lg font-semibold">Join the movement</h3>
            <p class="mt-2 text-sm text-slate-300">Connect with creators, organizers, and storytellers in your area.</p>
            <a href="/about" class="mt-4 inline-flex text-sm font-semibold text-emerald-300 hover:text-emerald-200">Learn More →</a>
        </article>
    </div>
</section>

<section class="mt-12 rounded-3xl border border-slate-800 bg-slate-900/60 p-8">
    <div class="flex flex-col gap-6 md:flex-row md:items-center md:justify-between">
        <div>
            <h2 class="text-2xl font-semibold">Stay Updated</h2>
            <p class="mt-2 text-sm text-slate-300">Subscribe to our newsletter for the latest street culture news.</p>
        </div>
        <form class="flex w-full flex-col gap-3 md:w-auto md:flex-row" hx-post="/subscribe" hx-target="#newsletter-result" hx-swap="innerHTML">
            <input name="email" type="email" placeholder="Enter your email" required class="w-full rounded-full border border-slate-700 bg-slate-950 px-4 py-3 text-sm text-white placeholder:text-slate-500 md:w-72" />
            <button type="submit" class="rounded-full bg-emerald-400 px-6 py-3 text-sm font-semibold text-black transition hover:bg-emerald-300">Subscribe</button>
        </form>
    </div>
    <div id="newsletter-result" class="mt-4 text-sm"></div>
</section>
{{ end }}
