{{ define "news" }}
<header class="flex flex-col gap-3">
    <p class="text-sm uppercase tracking-[0.2em] text-emerald-300">Newsroom</p>
    <h1 class="text-3xl font-semibold md:text-4xl">Street Culture News</h1>
    <p class="text-slate-300">Stay informed on the latest urban culture, events, and stories.</p>
</header>

<section class="mt-8 grid gap-6 lg:grid-cols-[2fr_1fr]">
    <article class="rounded-3xl border border-slate-800 bg-slate-900/60 p-8">
        <p class="text-xs uppercase tracking-widest text-emerald-300">Featured</p>
        <h2 class="mt-3 text-2xl font-semibold">Latest Urban Art Exhibition Opens Downtown</h2>
        <p class="mt-2 text-xs text-slate-400">January 15, 2026</p>
        <p class="mt-4 text-sm text-slate-300">Discover the incredible new street art exhibition showcasing works from local artists. This groundbreaking collection celebrates contemporary urban culture and pushes creative boundaries.</p>
        <a href="#" class="mt-4 inline-flex text-sm font-semibold text-emerald-300 hover:text-emerald-200">Read Full Story →</a>
    </article>

    <aside class="rounded-3xl border border-slate-800 bg-slate-900/60 p-6">
        <h3 class="text-lg font-semibold">What's trending</h3>
        <ul class="mt-4 space-y-4 text-sm text-slate-300">
            <li>Hip-Hop Festival Lineup Announced</li>
            <li>Street Style Trends Take Over Fashion Week</li>
            <li>Local Youth Center Opens Community Space</li>
        </ul>
    </aside>
</section>

<section class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
    <article class="rounded-2xl border border-slate-800 bg-slate-900/60 p-6">
        <p class="text-xs uppercase tracking-widest text-emerald-300">Music</p>
        <h3 class="mt-3 text-lg font-semibold">Hip-Hop Festival Lineup Announced</h3>
        <p class="mt-2 text-xs text-slate-400">January 14, 2026</p>
        <p class="mt-3 text-sm text-slate-300">The highly anticipated hip-hop festival reveals its star-studded lineup featuring both emerging and established artists.</p>
        <a href="#" class="mt-4 inline-flex text-sm font-semibold text-emerald-300 hover:text-emerald-200">Read More →</a>
    </article>
    <article class="rounded-2xl border border-slate-800 bg-slate-900/60 p-6">
        <p class="text-xs uppercase tracking-widest text-emerald-300">Fashion</p>
        <h3 class="mt-3 text-lg font-semibold">Street Style Trends Take Over Fashion Week</h3>
        <p class="mt-2 text-xs text-slate-400">January 13, 2026</p>
        <p class="mt-3 text-sm text-slate-300">See how street fashion is influencing high-fashion runways in this season's most anticipated shows.</p>
        <a href="#" class="mt-4 inline-flex text-sm font-semibold text-emerald-300 hover:text-emerald-200">Read More →</a>
    </article>
    <article class="rounded-2xl border border-slate-800 bg-slate-900/60 p-6">
        <p class="text-xs uppercase tracking-widest text-emerald-300">Community</p>
        <h3 class="mt-3 text-lg font-semibold">Local Youth Center Opens Community Space</h3>
        <p class="mt-2 text-xs text-slate-400">January 12, 2026</p>
        <p class="mt-3 text-sm text-slate-300">A new community hub launches to support local youth and provide space for creative expression and learning.</p>
        <a href="#" class="mt-4 inline-flex text-sm font-semibold text-emerald-300 hover:text-emerald-200">Read More →</a>
    </article>
    <article class="rounded-2xl border border-slate-800 bg-slate-900/60 p-6">
        <p class="text-xs uppercase tracking-widest text-emerald-300">Events</p>
        <h3 class="mt-3 text-lg font-semibold">Street Basketball Tournament This Weekend</h3>
        <p class="mt-2 text-xs text-slate-400">January 11, 2026</p>
